# Local development: copy to .env and fill in. Never commit .env (it is git-ignored).
# Production reads the same variables from render.yaml and the Render dashboard. Commented values are the defaults.

# ---- Model provider: openai | anthropic | gemini | openrouter. Only the chosen provider's key is needed.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...

# One model for every stage, generation and verification included. Leave unset to keep the per-stage defaults.
# TUTOR_MODEL=
# Per stage: TUTOR_MODEL_<STAGE> and TUTOR_EFFORT_<STAGE>. Defaults per provider in
# backend/core/shared/llm/infra/stage_configs.py; the production choice is in render.yaml.
# Stages: diagnosis, reply, guard, transcription, mistakes_generation, mistakes_verification, mistakes_grading,
# quiz_generation, quiz_verification, quiz_audit, quiz_grading, quiz_extraction.
# TUTOR_MODEL_REPLY=gpt-5.6-luna
# TUTOR_EFFORT_REPLY=none

# ---- Database. Unset: SQLite at data/tutor.db.
# Supabase: the transaction pooler URI (port 6543) as copied; URL-encode @ : / # in the password.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres
# 1: also store the full prompts in the LLM call log (large).
# TUTOR_LOG_PROMPTS=0

# ---- Access. Students never see solutions or traces; a professor opens the app once with ?prof=<key>.
# Generate a key: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# TUTOR_CLAU_PROFESSOR=
# Local development only: solutions, traces and /docs visible to everyone. Production pins 0.
TUTOR_DEMO=1

# ---- Limits. Requests per minute to the endpoints that call a model: per client, and all clients together.
# TUTOR_MODEL_REQUESTS_PER_MINUTE=20
# TUTOR_MODEL_REQUESTS_PER_MINUTE_GLOBAL=150
# Who may start a live (paid) generation of "Troba l'error" documents and "Cert o fals" quizzes: professor | tothom.
# TUTOR_GENERACIO=professor
# Time limit for one generation, in seconds.
# TUTOR_QUIZ_GENERATION_DEADLINE_S=420
# TUTOR_MISTAKES_GENERATION_DEADLINE_S=300

# ---- sympy checks. Worker processes (1 fits 512 MB) and the address-space cap per worker, POSIX only (0 = none).
# TUTOR_SYMPY_WORKERS=1
# TUTOR_SYMPY_WORKER_MEMORY_MB=256
# 1: decide the authored counterexamples at start-up (minutes of CPU on a small instance).
# TUTOR_SYMPY_WARM_CACHE=0
