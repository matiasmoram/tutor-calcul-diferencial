# Copy to .env and fill in. Never commit .env (it is git-ignored). See DEPLOY.md.

# ---- Model provider: openai | gemini | anthropic | openrouter
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# No global TUTOR_MODEL: it would override every stage, including generation/verification (quiz_*, mistakes_*).
# TUTOR_MODEL=
# Per-stage overrides (defaults depend on provider, see backend/core/shared/llm/infra/stage_configs.py)
# Stages: diagnosis, reply, guard, transcription, mistakes_generation, mistakes_verification, mistakes_grading,
# quiz_generation, quiz_verification, quiz_audit, quiz_grading, quiz_extraction
# Measured (2026-10): gpt-5.6-luna does well on the tutor stages and gradings at ~1/5 the cost of gpt-5.4-mini
# (per 1M tokens in/out: luna 0.20/1.20, mini 0.75/4.5, gpt-5.5 5/30). Generation/verification keep their defaults:
# gpt-5.4-mini there hit max_tokens on quiz generation and emitted NUL bytes in the JSON.
TUTOR_MODEL_DIAGNOSIS=gpt-5.6-luna
TUTOR_MODEL_REPLY=gpt-5.6-luna
TUTOR_MODEL_GUARD=gpt-5.6-luna
TUTOR_EFFORT_DIAGNOSIS=none
TUTOR_EFFORT_REPLY=none
TUTOR_EFFORT_GUARD=none
TUTOR_MODEL_TRANSCRIPTION=gpt-5.6-luna
TUTOR_MODEL_MISTAKES_GRADING=gpt-5.6-luna
TUTOR_MODEL_QUIZ_GRADING=gpt-5.6-luna

# ---- Database. Supabase (production, transaction pooler): postgresql+psycopg://postgres.<ref>:<password>@<host>:6543/postgres
# Unset: local SQLite at data/tutor.db
# DATABASE_URL=
# Also store full prompts in the LLM call log (large)
# TUTOR_LOG_PROMPTS=1

# ---- Professor key: students never see solutions/traces; professors open the app once with ?prof=<key>.
# Unset: nobody sees them, unless demo mode below.
# TUTOR_CLAU_PROFESSOR=
# Local development without a key: everything visible.
TUTOR_DEMO=1
# TUTOR_MODEL_REQUESTS_PER_MINUTE=20
# Cap for all clients together on the endpoints that call a model, on top of the per-client one
# TUTOR_MODEL_REQUESTS_PER_MINUTE_GLOBAL=150
# Who may trigger live (paid) generation of "Troba l'error" documents / "Cert o fals" quizzes: professor | tothom.
# Otherwise students get pre-generated content only (409 when none is ready).
# TUTOR_GENERACIO=professor
# Deadline for generating one quiz, seconds
# TUTOR_QUIZ_GENERATION_DEADLINE_S=420
# Deadline for generating one "Troba l'error" document, seconds
# TUTOR_MISTAKES_GENERATION_DEADLINE_S=300
# Address-space cap per sympy worker process, POSIX only (0 = none)
# TUTOR_SYMPY_WORKER_MEMORY_MB=256
# sympy worker processes (1 fits 512 MB) and whether to pre-decide the authored counterexamples at start-up
# TUTOR_SYMPY_WORKERS=1
# TUTOR_SYMPY_WARM_CACHE=0
