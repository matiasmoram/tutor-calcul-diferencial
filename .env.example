# Copy to .env and fill in. Never commit .env (it is git-ignored). See DEPLOY.md.

# ---- Model provider: openai | gemini | anthropic | openrouter
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# Recommended model for every stage (see work/research/INFORME.md)
TUTOR_MODEL=gpt-5.4-mini
# Optional per-stage overrides (defaults depend on provider, see backend/tutor/llm.py)
# TUTOR_MODEL_DIAGNOSI=gpt-5.4-mini
# TUTOR_EFFORT_DIAGNOSI=low

# ---- Database. Supabase (production): postgresql+psycopg://postgres.<ref>:<password>@<host>:6543/postgres
# Unset: local SQLite at data/tutor.db
# DATABASE_URL=
# Also store full prompts in the LLM call log (large)
# TUTOR_LOG_PROMPTS=1

# ---- Professor key: students never see solutions/traces; professors open the app once with ?prof=<key>.
# Unset: open demo mode (everything visible).
# TUTOR_CLAU_PROFESSOR=
